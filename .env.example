# NVIDIA NIM Configuration
NIM_API_KEY=nvapi-your-key-here
NIM_MODEL=meta/llama-3.3-70b-instruct

# Hugging Face Token (Required for Speaker Diarization)
HF_TOKEN=hf_your-huggingface-token-here

# ASR Model Path (defaults to parakeet-tdt-0.6b-v3.nemo in root)
ASR_MODEL_PATH=parakeet-tdt-0.6b-v3.nemo
CPU_THREADS=4
VAD_THRESHOLD=0.5

# Recordings Folder (default output directory)
RECORDINGS_DIR=C:\Users\lautt\OneDrive\Documentos\Programacion\LocalTranscription\recordings
